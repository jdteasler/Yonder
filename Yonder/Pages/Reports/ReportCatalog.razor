@page "/Reports"

@inject Yonder.Reports.Core.ReportRegistry Registry

<div class="container-fluid px-4 py-3">
    <div class="d-flex align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Report Catalog</h1>
            <p class="text-muted mb-0">Select a report to preview and export as PDF.</p>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var report in Registry.GetAll())
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 report-catalog-card">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@report.Title</h5>
                        <p class="card-text text-muted flex-grow-1">@report.Description</p>
                        <div class="mt-3">
                            <a href="/Reports/@report.Key" class="btn btn-primary btn-sm">
                                Open Report →
                            </a>
                        </div>
                    </div>
                    <div class="card-footer text-muted">
                        <small>Key: <code>@report.Key</code></small>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // No code needed – Registry is injected and GetAll() is called in markup.
}
