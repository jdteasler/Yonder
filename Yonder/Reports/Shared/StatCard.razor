@*
    StatCard – displays a single summary metric.
    Usage:
        <StatCard Label="Total Attendance" Value="@total.ToString()" />

    Compose several inside a <div class="stat-card-row">…</div>
    for a responsive side-by-side layout.
*@

<div class="stat-card">
    <div class="stat-card__value">@Value</div>
    <div class="stat-card__label">@Label</div>
    @if (!string.IsNullOrWhiteSpace(Sub))
    {
        <div class="stat-card__sub">@Sub</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    /// <summary>Optional small subscript (e.g. "vs. yesterday +12").</summary>
    [Parameter] public string Sub { get; set; } = "";
}
